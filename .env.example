# Copy this file to .env and replace the placeholder with your local database URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:DATABASE

# Required when starting the API server directly.
PORT=3000

# Optional for hosted deployments. Local Expo development derives the host
# from Expo's packager address so a changing LAN IP does not need to be saved.
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_API_PORT=5000
