{
  "expo": {
    "name": "Salatak Prayer Times",
    "slug": "salatak-prayer-times",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salatakprayer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sharaf001.salatakprayer",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sharaf001.salatakprayer",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F3EA"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EA",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "صلاتك يحتاج إلى الوصول إلى الصور لحفظ الخلفيات التي تختارها.",
          "savePhotosPermission": "صلاتك يحتاج إلى إذن لحفظ الخلفيات في صور جهازك.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "صلاتك يستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة بدقة."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "privacyPolicyUrl": "https://github.com/Sharaf001/Salatak-app/blob/main/PRIVACY.md"
    }
  }
}
